# Copy to .env.local (gitignored). Never commit real secrets.
#
# Local development can run without these values: Pint Drops use the in-memory
# demo store and /api/heritage uses the structured fallback. Production is
# different: set the required values below before deploy, or Pint Drop writes
# intentionally return 503 and admin moderation is unavailable.

# ── Required in production: Pint Drops persistence + photo storage ──
SUPABASE_URL=
# Server-only. NEVER commit a real value — bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pint-drops

# ── Required for browser auth (OAuth + email magic links) + Realtime ──
# Public browser values. The publishable key is safe to expose; never put the
# service-role key in a NEXT_PUBLIC_* variable. Magic-link delivery is enabled
# and configured in the Supabase dashboard/SMTP settings; it needs no app secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin for deployed auth and social-provider callbacks. Preview and
# deployment hosts must keep this value pointed at the production apex.
NEXT_PUBLIC_SITE_URL=https://pubmaxxing.com

# ── Required for public launch: remove seeded demo activity ──
# Local/keyless demos may leave this empty. Set the literal value `off` in BOTH
# Vercel Preview and Production before building a public release. This is a
# NEXT_PUBLIC_* build-time setting, so changing it requires a fresh deployment.
NEXT_PUBLIC_DEMO_CONTENT=

# ── Required for Clerk sign-in and sign-up ──
# Clerk runs BESIDE Supabase auth; it does not replace it. Set BOTH values or
# neither. With neither, Clerk stays off and the app behaves exactly as before:
# proxy.ts ships the plain security proxy and the Clerk buttons do not render.
#
# With only the publishable key, the site still works but Clerk account controls
# remain hidden. They also require an established product Supabase session
# until a Clerk-to-Supabase identity bridge exists end to end. proxy.ts requires
# BOTH Clerk keys before it runs clerkMiddleware(), because clerkMiddleware()
# throws on every request without the secret key.
#
# The publishable key is safe to expose. It also encodes the instance Frontend
# API host, which lib/clerkIdentity.ts decodes to build the exact Clerk origins
# for the Content-Security-Policy, so no Clerk host is hardcoded anywhere.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only. NEVER commit a real value and never put it in a NEXT_PUBLIC_*
# variable. Copy it from the Clerk dashboard: API keys, Secret keys.
CLERK_SECRET_KEY=

# ── Optional: Social emergency rollback ──
# Social is live by default. Set to 0 only to return Social to preview during an
# incident. PUBMAX_SOCIAL_FREEZE remains the separate ops brake that can pause
# writes without hiding the surface.
PUBMAX_SOCIAL_FRIENDS_LAUNCH=

# ── Optional: image moderation (Social posts + owned profile avatars) ──
# Server-only. Social post moderation crons require OPENAI_API_KEY (omni endpoint).
# Owned-avatar upload prefers OPENAI_API_KEY when set; otherwise OPENROUTER_API_KEY
# drives a vision classifier (OPENROUTER_MODERATION_MODEL, default openai/gpt-5.2).
# With neither key, owned-image scans are skipped and uploads still proceed;
# one warning records the missing safety net. Post moderation queues stay
# pending. Keyless local dev and Playwright e2e omit both on purpose so these
# paths stay honest.
OPENAI_API_KEY=

# ── Optional: external social profile connections ──
# Account Hub advertises an OAuth provider only when its client id/key, secret,
# and the shared encryption key are all present server-side. The encryption key
# must be at least 32 characters and protects stored provider credentials.
# Manual personal Instagram links remain available without OAuth credentials.
SOCIAL_CONNECTION_ENCRYPTION_KEY=
X_CLIENT_ID=
X_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Optional: staged Convex hybrid (disabled by default) ──
# These non-secret identity-provider values are configured on the Convex
# deployment, not exposed as NEXT_PUBLIC_* values. PubMax remains Supabase-only
# when they are absent. Supabase must use an asymmetric RS256 or ES256 signing
# key; legacy HS256 secrets are intentionally not supported.
CONVEX_SUPABASE_JWT_ISSUER=
CONVEX_SUPABASE_JWKS_URL=
CONVEX_SUPABASE_JWT_AUDIENCE=authenticated
CONVEX_SUPABASE_JWT_ALGORITHM=ES256

# ── Required in production: moderation admin + durable rate limiting ──
# assertServerEnv() FATALs at route import if either value below is unset in production.
# RATE_LIMIT_SALT must be a unique randomly generated secret of at least 32
# bytes — not the dev default "pubmax-rate-limit". It also backs trusted Plan
# signing and referral signup proofs when PLAN_IDEMPOTENCY_SECRET is omitted.
ADMIN_TOKEN=
# UUID of the active private_social_staff_roles row bound to ADMIN_TOKEN.
SOCIAL_MODERATOR_STAFF_ROLE_ID=
RATE_LIMIT_SALT=
# Optional dedicated HMAC secret (at least 32 random bytes) for retry-safe Plan
# writes, grounding proofs, referral signup proofs, and verified loop analytics.
# When omitted, the required production RATE_LIMIT_SALT is used. With neither
# secret, only the keyless in-memory demo works: it uses a random per-process
# key, so its proofs and event tokens intentionally expire on restart.
PLAN_IDEMPOTENCY_SECRET=

# ── Optional: The Landlord heritage agent (Claude via OpenRouter) ──
# Without a key, /api/heritage returns grounded, structured-only answers
# (the honest fallback) instead of a narrated reply. The same key also backs
# owned-avatar moderation when OPENAI_API_KEY is absent (see above).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
# Vision model for avatar moderation when OpenAI is not configured.
OPENROUTER_MODERATION_MODEL=openai/gpt-5.2

# ── Optional: iOS native push (APNs) ──
# Keep every value server-only. Never commit an APNs .p8 key.
# Preserve PEM newlines as literal \n escapes when the host requires one line.
# Use production for TestFlight and App Store builds. Use sandbox only for
# development-signed builds whose device tokens come from the APNs sandbox.
# When APNs credentials are present, APNS_ENV must be production or sandbox.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_ENV=

# ── Optional: installed-web push (VAPID) ──
# Both keys come from one long-lived VAPID keypair. The public key is safe to
# expose to the installed PWA; the private key is server/operator-only. With
# either key absent, web delivery truthfully skips and `npm run push:daily`
# prints the exact missing configuration without failing local development.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact URI sent to browser push services. Defaults to the value
# below; must start with mailto: or https:.
VAPID_SUBJECT=mailto:hello@pubmaxxing.com

# ── Optional: Android native push (Firebase Cloud Messaging) ──
# Copy these four server-only values from one least-privilege Firebase service
# account. Set all four or none. A partial set fails Android delivery loudly.
# Never commit the service-account JSON or private key.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY_ID=
FCM_PRIVATE_KEY=

# ── Optional: get-home ride handoff (Uber deep link) ──
# Self-serve client id from developer.uber.com. When empty, the Getting Home
# handoff row omits Uber and keeps Citymapper plus Google Maps transit only.
NEXT_PUBLIC_UBER_CLIENT_ID=

# ── Optional: the founders' Discord invite ──
# Shown ONLY to a founding member (one of the first 100 claimed handles), on the
# You surface and once in the arrival greeting. Nobody else ever sees it, and
# nothing in the product is gated behind it: founding buys belonging only.
# Must be an https invite on discord.gg or discord.com; anything else is
# ignored and the door simply does not render. Empty here on purpose, and empty
# ships no door: the real invite is a live door into a private room, so it lives
# in the deployment environment and never in the tree.
# Format: NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/<invite-code>
NEXT_PUBLIC_DISCORD_INVITE_URL=

# ── Optional: consent-gated standard product analytics (PostHog EU) ──
# Explicit pageviews, browser exceptions, and server-side product events use
# the same EU project. Product events keep the closed event/property registry;
# pageviews keep a separate closed path vocabulary. Neither sends account
# identity, free text, query strings, or precise location. Browser SDK
# persistence uses a consent-gated device identity in localStorage and cookies.
# Do Not Track remains enforced; autocapture and session recording stay off.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional server-only override retained for existing deployments.
POSTHOG_PROJECT_API_KEY=

# ── Optional: Pub Pal conversational voice (ElevenLabs Agents) ──
# Runbook: docs/PUB_PAL_SETUP.md. Create or update the agent with
# `npm run pubpal:agent -- --base-url https://your-deployment`.
# Both values are server-only. /api/pub-pal/voice-token returns a temporary
# signed session URL to authenticated users; the API key never reaches React.
# Configure the ElevenLabs agent for no audio saving / zero retention.
ELEVENLABS_API_KEY=
ELEVENLABS_PUB_PAL_AGENT_ID=
# Curated per-pal voice ids (ember / velvet / signal in lib/pubPal.ts). Leave
# empty to keep the agent dashboard default for that slot.
ELEVENLABS_VOICE_EMBER=
ELEVENLABS_VOICE_VELVET=
ELEVENLABS_VOICE_SIGNAL=
# Shared secret for the Custom LLM bridge at /api/pub-pal/llm (server-only).
# ElevenLabs sends this as Authorization Bearer or x-elevenlabs-llm-secret.
ELEVENLABS_LLM_SHARED_SECRET=

# ── Optional: Firecrawl (menu scraping, Wetherspoon directory refresh, research) ──
# Used by scripts/firecrawl_greene_king_prices.mjs, scripts/fetch_wetherspoons_pubs.mjs,
# and the firecrawl CLI. Never commit a real key; local copy lives in .env (gitignored).
# Get a key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# ── Optional: Context.dev web reads (registered-source events lane) ──
# Server-only. Used by lib/contextDev.server.ts and the Context.dev events lane
# in scripts/whatson/eventsRefresh.mjs for allowed venue-events pages listed in
# lib/harvest/sourcePolicy.ts. Never commit a real key; local copy lives in
# .env.local (gitignored). Get a key at https://context.dev
CONTEXT_DEV_API_KEY=

# ── Optional: search providers (official pub-page discovery) ──
# Server-only. docs/DEPLOYMENT.md owns provider selection and credentials;
# docs/CRON_PLANE_RUNBOOK.md owns fallback, billing, and spend logs.
SEARCH_PROVIDER=exa
AI_GATEWAY_API_KEY=
SEARCH_GATEWAY_MAX_CALLS=25
# The city enrichment CLI still uses its direct Tavily path until migrated.
TAVILY_API_KEY=

# ── Optional: weekly email digest (Cycle 8 — "your London week in pints") ──
# Delivery is a no-op until BOTH are set (lib/emailProvider.ts selectEmailProvider);
# scripts/send_weekly_digest.mjs then still gates on explicit per-user opt-in.
# Resend is the recommended default; Postmark is a drop-in alternative (see
# docs/EMAIL_DIGEST.md). EMAIL_FROM must be a verified sender on the provider
# (e.g. hello@pubmaxxing.com once the domain is verified).
RESEND_API_KEY=
EMAIL_FROM=

# ── Optional: Exa (scheduled signals ingestion — sol.md TL-6) ──
# Powers the scheduled signals-ingestion job. Without a key that job is skipped;
# nothing in the interactive app path depends on it. Get a key at https://exa.ai
EXA_API_KEY=

# ── Optional: Keenable area-news refresh ──
# `npm run refresh:area-news` uses this key when set. Without it, the job uses
# Keenable's public research endpoint. The job fails loudly on provider errors
# and never replaces the existing dataset with an empty result.
KEENABLE_API_KEY=

# ── Optional: Ticketmaster + Skiddle (What's-On events / /out) ──
# scripts/whatson/eventsRefresh.mjs and the /api/out live supplement read these
# at runtime. A missing key is a not-configured lane, never an empty market.
# TICKETMASTER_API_KEY is free from developer.ticketmaster.com.
TICKETMASTER_API_KEY=
# SKIDDLE_API_KEY needs written commercial approval from dev@skiddle.com first.
# Without it the Skiddle lane stays not-configured. Name + logo + event link
# are licence obligations whenever a Skiddle row is on screen.
SKIDDLE_API_KEY=

# ── Optional: Eventbrite (Tonight events, own-org only) ──
# app/api/events/tonight surfaces the authenticated account's OWN Eventbrite
# events. Eventbrite removed public event search in 2019, so a private token
# grants NO London-wide discovery — it only reads events under your own
# organizations. Without the token the route returns an empty, fail-soft result.
# Get a token at https://www.eventbrite.com/platform/api-keys
EVENTBRITE_API_TOKEN=

# ── Optional: TfL app key (Last Pint / last-train, nearby bus departures) ──
# lib/tflClient.server.ts uses the keyless TfL API by default for every TfL read;
# a key is only appended when present, buying higher rate limits. Both features
# work fully without it.
TFL_APP_KEY=

# ── Optional: extra identity-hash salts ──
# Both fall back safely: ACTOR_HASH_SALT → RATE_LIMIT_SALT → a dev default;
# PLAN_MEMBER_TOKEN_SALT → ACTOR_HASH_SALT → a dev default. Set distinct secrets
# in production so per-actor / plan-member hashes aren't computable from public code.
ACTOR_HASH_SALT=
PLAN_MEMBER_TOKEN_SALT=

# ── Optional: dev/test toggles ──
# RATE_LIMIT_STRICT=1 forces Pint Drop rate limiting on even outside production
# (used to exercise the limiter locally). Leave unset normally.
RATE_LIMIT_STRICT=
# Selects in-memory stores for local production-style Playwright QA. It never
# relaxes trusted signing: playwright.config.ts injects a fresh random secret
# through webServer.env for every run. Never configure this on a deployment.
PUBMAX_E2E_KEYLESS=
# Cache-busting version for the service worker. Auto-defaults to a build timestamp
# when unset; set explicitly only to pin the SW cache key across a deploy.
NEXT_PUBLIC_SW_VERSION=
# Deployment marker for local or prebuilt Next.js builds. Vercel supplies its
# own marker for Git deployments; set this only when serving a prebuilt bundle.
DEPLOYMENT_VERSION=

# ── Vercel-injected (do not set by hand) ──
# VERCEL_OIDC_TOKEN is supplied by the Vercel CLI / build (e.g. `vercel env pull`,
# `vercel dev`) for local OIDC federation. Production functions receive OIDC
# through request context. AI SDK Gateway auth resolves both paths automatically.
VERCEL_OIDC_TOKEN=
